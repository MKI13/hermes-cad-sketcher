{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ef-sinn.local/hermes-cad/render-job.schema.json",
  "title": "Hermes CAD Render Job",
  "type": "object",
  "required": [
    "version",
    "engine",
    "quality",
    "width",
    "height",
    "sceneSnapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "engine": {
      "enum": [
        "three-preview",
        "blender-eevee",
        "blender-cycles"
      ]
    },
    "quality": {
      "enum": [
        "draft",
        "preview",
        "final"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 7680
    },
    "height": {
      "type": "integer",
      "minimum": 240,
      "maximum": 4320
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "cameraId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "sceneSnapshot": {
      "type": "object"
    },
    "outputName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  }
}
